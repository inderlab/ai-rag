      "position": [
        0,
        0
      ],
      "webhookId": "6f1c2b8e-1a01-4c0e-9a10-0000000000aa"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
