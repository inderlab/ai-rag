          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "video.ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6f1c2b8e-1a01-4c0e-9a10-000000000002",
      "name": "Is ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=✅ Video ready: {{ $json.body.video.title }}\n\n{{ $json.body.insights ? $json.body.insights.summary : 'Summary is still being generated.' }}\n\nChapters: {{ $json.body.insights ? $json.body.insights.chapters.length : 0 }} · Chunks: {{ $json.body.video.chunk_count }}\nOpen: {{ $json.body.video.app_url }}",
        "additionalFields": {}
      },
      "id": "6f1c2b8e-1a01-4c0e-9a10-000000000003",
      "name": "Telegram ready",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=❌ Video failed: {{ $json.body.video.title || $json.body.video.youtube_id }}\nReason: {{ $json.body.video.error }}\n{{ $json.body.video.url }}",
        "additionalFields": {}
      },
      "id": "6f1c2b8e-1a01-4c0e-9a10-000000000004",
      "name": "Telegram failed",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
