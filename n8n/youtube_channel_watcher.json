{
  "name": "VidMind - YouTube channel watcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "7a2d3c9f-2b02-4d1f-8b20-000000000001",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "channel_id",
              "value": "YOUR_YOUTUBE_CHANNEL_ID",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "api_url",
              "value": "http://host.docker.internal:8000/api",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "hours",
              "value": 6,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "7a2d3c9f-2b02-4d1f-8b20-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://www.youtube.com/feeds/videos.xml?channel_id={{ $json.channel_id }}",
        "options": {}
      },
      "id": "7a2d3c9f-2b02-4d1f-8b20-000000000003",
      "name": "Channel RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ new Date($json.isoDate || $json.pubDate).getTime() > Date.now() - $('Config').item.json.hours * 3600 * 1000 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7a2d3c9f-2b02-4d1f-8b20-000000000004",
      "name": "Only new uploads",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_url }}/videos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.link }) }}",
        "options": {}
      },
      "id": "7a2d3c9f-2b02-4d1f-8b20-000000000005",
      "name": "Add to VidMind",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Channel RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel RSS": {
      "main": [
        [
          {
            "node": "Only new uploads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only new uploads": {
      "main": [
        [
          {
            "node": "Add to VidMind",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}